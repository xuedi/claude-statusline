# Maintainer: Daniel Koch <xuedi@beijingcode.org>
# Generated from packaging/PKGBUILD.in - do not edit by hand.
pkgname=claude-statusline-bin
_binname=claude-statusline
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Statusline renderer for Claude Code: model, git, token usage, effort, rate limits"
arch=('x86_64')
url="https://github.com/xuedi/claude-statusline"
license=('EUPL-1.2')
provides=("$_binname")
conflicts=("$_binname")
options=('!strip' '!debug')
source=("@SOURCE@")
sha256sums=('@SHA256@')

package() {
    install -Dm755 "$srcdir/$_binname" "$pkgdir/usr/bin/$_binname"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$_binname/README.md"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$_binname/LICENSE"
}
